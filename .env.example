# WARNING: this default sends the complete script and planning prompt to OpenAI.
# Use only after reviewing and approving that disclosure. The compatible endpoint
# below is the intended local-provider route once a model passes the director evals.
DIRECTOR_LLM_PROVIDER=openai
DIRECTOR_LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=

# For an OpenAI-compatible local server, set provider=compatible and configure:
DIRECTOR_LLM_BASE_URL=http://127.0.0.1:11434/v1
DIRECTOR_LLM_API_KEY=local

COMFYUI_BASE_URL=http://127.0.0.1:8188
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
LTX_RUNTIME_ROOT=.runtime/LTX-2
LTX_MODELS_ROOT=models

# Measured M5/32 GB candidate defaults. Every value is overridable per render.
# 448x256 is faster only modestly and failed the first facial-quality review.
LTX_DEFAULT_WIDTH=1024
LTX_DEFAULT_HEIGHT=576
LTX_DEFAULT_FRAMES=121
LTX_DEFAULT_FRAME_RATE=24
LTX_DEFAULT_OFFLOAD=disk
LTX_DEFAULT_MAX_BATCH_SIZE=1
# Runtime reserve after models are installed. Sequential clip count does not multiply it.
LTX_MINIMUM_FREE_GIB=20
